# ==============================================================================
# AIR-GAPPED ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================
# Zero-External Network Configuration
# All services resolve strictly through Docker's internal DNS daemon (127.0.0.11)
# ==============================================================================

COMPOSE_PROJECT_NAME=airgap_fortress

FRONTEND_HOST_PORT=80
FASTAPI_HOST_PORT=8000
ASSET_SERVER_HOST_PORT=8080

POSTGIS_HOST=postgis
POSTGIS_PORT=5432
POSTGIS_DB=geodata
POSTGIS_USER=fortress_user
POSTGIS_PASSWORD=AirGapSecurePassword2026!

QDRANT_HOST=qdrant
QDRANT_PORT=6333

ML_SERVICE_HOST=ml-service
ML_SERVICE_PORT=5000

ASSET_SERVER_HOST=asset-server
ASSET_SERVER_PORT=80

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

TENSORRT_ENGINE_PATH=/models/satellite_infer_fp16.engine
INFERENCE_BATCH_SIZE=1
TARGET_LATENCY_MS=420
